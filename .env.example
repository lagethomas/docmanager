# -----------------------------------------------------------------------------
# WP Masters Core - Arquivo de Exemplo do Ambiente (.env)
# Atencao: Renomeie este arquivo para .env em producao e defina as chaves reais.
# -----------------------------------------------------------------------------

# --- APP CONFIGURATION ---
APP_ENV=development             # 'development' ou 'production'
APP_TIMEZONE=America/Sao_Paulo  # Timezone padrao do sistema
APP_DATE_FORMAT="d/m/Y H:i"    # Formato de data principal
APP_KEY=                        # Chave de criptografia (32 caracteres recomendados) - php -r "echo bin2hex(random_bytes(16));"
SITE_URL=http://site.local      # URL base do sistema (ex: https://meusaas.com)
LOGS=true                       # Quando true, forca a gravacao de logs php mesmo desativado no painel

# --- SESSION ---
SESSION_NAME=n
SESSION_LIFETIME=480

# --- SYSTEM ---
SYSTEM_NAME=DocManager
SYSTEM_VERSION=1.0.0

# --- DATABASE (MariaDB) ---
DB_HOST=127.0.0.1              # Host do servidor de banco de dados
DB_PORT=3306                   # Porta (padrao 3306)
DB_NAME=                       # Nome da base de dados
DB_USER=                       # Utilizador da DB
DB_PASS=                       # Password da DB
DB_CHARSET=utf8mb4             # Charset (recomendado utf8mb4)

# --- CACHE & SESSION (Redis) ---
# Se REDIS_HOST estiver definido, o Cache e as sessoes utilizara Redis.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5
SESSION_PREFIX=core            # Prefixo das chaves de sessao no Redis. Mude para cada app que usar o mesmo Redis.

# --- QUEUE ---
# Driver da fila de notificacoes: 'database' (padrao) ou 'redis' (alta escala)
QUEUE_DRIVER=database

# Configuracao padrao do worker (pode ser sobrescrita por flags do CLI queue-work.php)
QUEUE_WORKER_QUEUE=            # Tipos a processar, separados por virgula (vazio = todos)
QUEUE_WORKER_TRIES=3           # Maximo de tentativas por job
QUEUE_WORKER_TIMEOUT=60        # Timeout (s) de cada job antes de ser abortado
QUEUE_WORKER_SLEEP=3           # Pausa (s) quando a fila esta vazia
QUEUE_WORKER_MAX_JOBS=0        # Max. jobs antes de encerrar (0 = ilimitado)
QUEUE_WORKER_MAX_TIME=0        # Max. tempo total do worker em segundos (0 = ilimitado)
QUEUE_WORKER_MEMORY=128        # Limite de memoria em MB (worker encerra ao atingir)
QUEUE_WORKER_BACKOFF=0         # Atraso (s) antes de re-tentar um job com falha

# --- EMAIL / SMTP ---
SMTP_HOST=                    # Host SMTP (ex: smtp.sendgrid.net). Vazio = fallback mail()
SMTP_PORT=587                 # Porta SMTP (25, 465 ssl, 587 tls)
SMTP_USER=                    # Usuario SMTP (vazio = sem autenticacao)
SMTP_PASS=                    # Senha SMTP
SMTP_ENCRYPTION=tls           # tls | ssl | vazio (nenhuma)
SMTP_FROM=nao-responda@example.com
SMTP_FROM_NAME="DocManager"

# --- OFFICE 365 (MICROSOFT ENTRA ID) LOGIN ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TENANT_ID=common
OAUTH_REDIRECT_URI=

