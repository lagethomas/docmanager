{
    "name": "wpmasters/portal-quebras",
    "description": "Portal de Quebras - Operacao Logistica (MVC PHP sem framework + MariaDB)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "dompdf/dompdf": "^3.1",
        "erusev/parsedown": "^1.8",
        "phpmailer/phpmailer": "^7.1",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "lint": "find src public bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    }
}
